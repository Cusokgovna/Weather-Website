# Copy this file to ".env" and fill in your values.
# ".env" is in .gitignore — never commit real passwords and keys!

# Port of the website (http://localhost:3000)
PORT=3000

# OpenWeather API key: https://home.openweathermap.org/api_keys
OPENWEATHER_KEY=

# ---- Microsoft SQL Server ----
# mssql = real SQL Server, memory = no database (data in RAM, for quick demo only)
DB_DRIVER=mssql
# localhost when the site runs on your PC (npm start)
# host.docker.internal when the site runs in Docker and SQL Server is on your PC
# db when everything runs via docker-compose.db.yml
DB_SERVER=localhost
DB_PORT=1433
# For a named instance (e.g. SQLEXPRESS) set DB_INSTANCE=SQLEXPRESS and leave DB_PORT empty
DB_INSTANCE=
DB_NAME=WeatherDb
DB_USER=weather_app
DB_PASSWORD=
DB_ENCRYPT=true
# true for local development (self-signed certificate of SQL Server)
DB_TRUST_CERT=true

# true only when the site is served over HTTPS
COOKIE_SECURE=false
