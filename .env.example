# Copy this file to ".env" and fill in your values:  copy .env.example .env
# ".env" is in .gitignore and .dockerignore — never commit real passwords!

# Port of the website: http://localhost:3000
PORT=3000

# Public address of the site (used in sitemap.xml, robots.txt and canonical links)
SITE_URL=https://example.com

# ---- Microsoft SQL Server ----
# mssql  = real SQL Server (default)
# memory = no database: demo data in RAM, lost on restart (quick check without SQL Server)
DB_DRIVER=mssql
# localhost             — the site runs on your PC (npm start / F5 in VS Code)
# host.docker.internal  — the site runs in Docker, SQL Server is installed on your PC
# (docker-compose.db.yml sets DB_SERVER=db by itself)
DB_SERVER=localhost
DB_PORT=1433
# Named instance without a fixed port (e.g. SQLEXPRESS): set DB_INSTANCE=SQLEXPRESS and leave DB_PORT empty
DB_INSTANCE=
DB_NAME=KrakenShop
# Login created by database/06_app_login.sql (or "sa" for the database in Docker)
DB_USER=kraken_app
DB_PASSWORD=
DB_ENCRYPT=true
# true for local development (self-signed certificate of SQL Server)
DB_TRUST_CERT=true

# true only when the site is served over HTTPS
COOKIE_SECURE=false
