erDiagram
    Users ||--o{ Sessions : "входит"
    Games ||--o{ Categories : "содержит"
    Categories ||--o{ Listings : "включает"
    Users ||--o{ Listings : "продаёт"
    Listings ||--o{ Orders : "покупают"
    Users ||--o{ Orders : "покупатель"
    Users ||--o{ Orders : "продавец"
    Orders ||--o{ Messages : "чат"
    Users ||--o{ Messages : "пишет"
    Orders ||--o| Reviews : "отзыв"
    Users ||--o{ Reviews : "автор / продавец"
    Users ||--o{ Transactions : "кошелёк"
    Orders ||--o{ Transactions : "оплата"

    Users {
        INT UserId PK
        NVARCHAR(32) Username UK
        NVARCHAR(255) Email UK
        NVARCHAR(255) PasswordHash
        NVARCHAR(MAX) AvatarDataUrl "NULL"
        DECIMAL(12_2) Balance ">= 0"
        DATETIME2 CreatedAt
        DATETIME2 UpdatedAt
    }
    Sessions {
        INT SessionId PK
        INT UserId FK
        CHAR(64) TokenHash UK
        DATETIME2 CreatedAt
        DATETIME2 ExpiresAt
    }
    Games {
        INT GameId PK
        NVARCHAR(100) Name UK
        VARCHAR(50) Slug UK
        NVARCHAR(500) Description "NULL"
        INT SortOrder
    }
    Categories {
        INT CategoryId PK
        INT GameId FK
        NVARCHAR(100) Name
        VARCHAR(50) Slug "UK with GameId"
        VARCHAR(10) Kind "item|currency|account|service"
    }
    Listings {
        INT ListingId PK
        INT SellerId FK
        INT CategoryId FK
        NVARCHAR(120) Title
        NVARCHAR(2000) Description "NULL"
        DECIMAL(12_2) Price "> 0"
        INT Quantity ">= 0"
        VARCHAR(10) Status "active|sold|closed"
        DATETIME2 CreatedAt
        DATETIME2 UpdatedAt
    }
    Orders {
        INT OrderId PK
        INT ListingId FK
        INT BuyerId FK
        INT SellerId FK
        INT Quantity
        DECIMAL(12_2) UnitPrice
        DECIMAL(12_2) TotalPrice "computed"
        VARCHAR(10) Status "paid|completed|disputed|refunded"
        DATETIME2 CreatedAt
        DATETIME2 ClosedAt "NULL"
    }
    Transactions {
        BIGINT TransactionId PK
        INT UserId FK
        INT OrderId FK "NULL"
        DECIMAL(12_2) Amount
        VARCHAR(10) Type "deposit|purchase|sale|refund"
        DECIMAL(12_2) BalanceAfter
        DATETIME2 CreatedAt
    }
    Reviews {
        INT ReviewId PK
        INT OrderId FK,UK
        INT AuthorId FK
        INT SellerId FK
        TINYINT Rating "1..5"
        NVARCHAR(1000) Text "NULL"
        DATETIME2 CreatedAt
    }
    Messages {
        BIGINT MessageId PK
        INT OrderId FK
        INT SenderId FK
        NVARCHAR(1000) Text
        DATETIME2 CreatedAt
    }
